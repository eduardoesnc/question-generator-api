API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=*

KEYWORDS_THRESHOLD=0.20
EMBEDDINGS_THRESHOLD=0.30
CONFIDENCE_MIN=0.50
CONFIDENCE_MAX=0.95
MAX_TEXT_LENGTH=1000

# Onde o modelo será salvo/lido dentro do container
MODELS_DIR=/app/models

# Fonte do modelo: local | minio | s3 | huggingface
MODEL_SOURCE=local

# Necessário quando MODEL_SOURCE=minio ou s3
# MINIO_ENDPOINT=minio.machlev.com.br
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=ml-models
# MINIO_MODEL_PATH=bncc-embeddings-finetuned

# Necessário quando MODEL_SOURCE=huggingface
# HF_MODEL_ID=seu-usuario/bncc-embeddings-finetuned

# Necessário para o modo LLM (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
